# ==============================================
# DATABASE
# ==============================================
DATABASE_URL="postgresql://housing:housing123@localhost:5432/housing?schema=public"

# ==============================================
# REDIS
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================
# JWT AUTHENTICATION
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-long-and-random
JWT_EXPIRES_IN=7d

# ==============================================
# APPLICATION URLS
# ==============================================
# Web App (Buyer/Tenant facing)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Admin Panel
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
# API Backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# ==============================================
# API CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# ==============================================
# AWS S3 (For file uploads - Phase 1)
# ==============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ==============================================
# EMAIL (For notifications - Phase 1)
# ==============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@housing.com

# ==============================================
# SMS (For notifications - Phase 2)
# ==============================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==============================================
# PAYMENT GATEWAY (Phase 5)
# ==============================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ==============================================
# ELASTICSEARCH (Phase 6)
# ==============================================
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
