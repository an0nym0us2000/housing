// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MANAGEMENT
// ============================================

enum UserRole {
  BUYER
  OWNER
  BROKER
  BUILDER
  ADMIN
  MODERATOR
  SUPPORT
  FINANCE
  MARKETING
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  phone     String?
  role      UserRole @default(BUYER)
  status    UserStatus @default(ACTIVE)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  avatar    String?
  bio       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  // Relations
  listings        Listing[]
  leads           Lead[]
  savedListings   SavedListing[]
  createdLeads    Lead[]           @relation("LeadCreatedBy")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

// ============================================
// CITIES AND LOCALITIES (For Phase 1)
// ============================================

model City {
  id        String   @id @default(cuid())
  name      String
  state     String
  country   String   @default("India")

  latitude  Float?
  longitude Float?

  isActive  Boolean  @default(true)
  priority  Int      @default(0) // For ordering popular cities

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  localities Locality[]
  listings   Listing[]

  @@unique([name, state])
  @@index([isActive, priority])
  @@map("cities")
}

model Locality {
  id        String   @id @default(cuid())
  name      String
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  pincode   String?

  latitude  Float?
  longitude Float?

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings  Listing[]

  @@unique([name, cityId])
  @@index([cityId])
  @@index([isActive])
  @@map("localities")
}

// ============================================
// LISTINGS (PROPERTIES)
// ============================================

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  VILLA
  INDEPENDENT_HOUSE
  PLOT
  COMMERCIAL
  OFFICE
  SHOP
  WAREHOUSE
  PG
  HOSTEL
}

enum ListingStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  EXPIRED
  SOLD
  RENTED
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum AvailabilityStatus {
  IMMEDIATE
  WITHIN_15_DAYS
  WITHIN_30_DAYS
  AFTER_30_DAYS
}

model Listing {
  id        String   @id @default(cuid())

  // Ownership
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic Info
  title     String
  description String  @db.Text

  listingType    ListingType
  propertyType   PropertyType
  status         ListingStatus @default(DRAFT)

  // Location
  cityId      String
  city        City      @relation(fields: [cityId], references: [id])
  localityId  String
  locality    Locality  @relation(fields: [localityId], references: [id])
  address     String    @db.Text
  pincode     String?
  latitude    Float?
  longitude   Float?

  // Property Details
  bhk         Int?      // Number of bedrooms (1, 2, 3, 4, etc.)
  bathrooms   Int?
  balconies   Int?

  carpetArea      Float?   // in sq ft
  builtUpArea     Float?   // in sq ft
  plotArea        Float?   // in sq ft

  furnishing      FurnishingStatus?

  totalFloors     Int?
  floorNumber     Int?

  // Pricing
  price           Float    // Main price
  pricePerSqft    Float?
  securityDeposit Float?   // For rent
  maintenanceFee  Float?   // Monthly maintenance

  // Availability
  availability    AvailabilityStatus?
  possessionDate  DateTime?

  // Age
  propertyAge     Int?     // in years

  // Features
  parking         Boolean  @default(false)
  parkingCount    Int?

  // Listing Management
  viewCount       Int      @default(0)
  contactCount    Int      @default(0)

  isFeatured      Boolean  @default(false)
  featuredUntil   DateTime?

  rejectionReason String?  @db.Text

  moderatedBy     String?
  moderatedAt     DateTime?

  publishedAt     DateTime?
  expiresAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  media           Media[]
  amenities       ListingAmenity[]
  leads           Lead[]
  savedBy         SavedListing[]

  @@index([userId])
  @@index([cityId])
  @@index([localityId])
  @@index([status])
  @@index([listingType])
  @@index([propertyType])
  @@index([price])
  @@index([publishedAt])
  @@map("listings")
}

// ============================================
// MEDIA (IMAGES & VIDEOS)
// ============================================

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Media {
  id          String    @id @default(cuid())

  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  type        MediaType @default(IMAGE)
  url         String
  thumbnailUrl String?

  title       String?
  description String?

  size        Int?      // in bytes
  mimeType    String?

  displayOrder Int      @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([listingId])
  @@index([displayOrder])
  @@map("media")
}

// ============================================
// AMENITIES
// ============================================

model Amenity {
  id          String   @id @default(cuid())
  name        String   @unique
  icon        String?
  category    String?  // e.g., "security", "lifestyle", "common_area"
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings    ListingAmenity[]

  @@index([category])
  @@map("amenities")
}

model ListingAmenity {
  id          String   @id @default(cuid())

  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  amenityId   String
  amenity     Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([listingId, amenityId])
  @@index([listingId])
  @@index([amenityId])
  @@map("listing_amenities")
}

// ============================================
// LEADS & INQUIRIES
// ============================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISIT_SCHEDULED
  VISITED
  NEGOTIATION
  WON
  LOST
  SPAM
}

enum LeadSource {
  PHONE_REVEAL
  CHAT
  EMAIL
  CALL
  WEBSITE_FORM
}

model Lead {
  id          String     @id @default(cuid())

  // Listing
  listingId   String
  listing     Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Lead info (buyer/tenant)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  name        String
  email       String?
  phone       String

  message     String?    @db.Text

  status      LeadStatus @default(NEW)
  source      LeadSource

  // Owner assignment
  ownerId     String
  owner       User       @relation("LeadCreatedBy", fields: [ownerId], references: [id])

  isRead      Boolean    @default(false)
  readAt      DateTime?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([listingId])
  @@index([userId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

// ============================================
// SAVED LISTINGS (WISHLIST)
// ============================================

model SavedListing {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("saved_listings")
}
