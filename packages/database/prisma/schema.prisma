// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MANAGEMENT
// ============================================

enum UserRole {
  BUYER
  OWNER
  BROKER
  BUILDER
  ADMIN
  MODERATOR
  SUPPORT
  FINANCE
  MARKETING
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  phone     String?
  role      UserRole @default(BUYER)
  status    UserStatus @default(ACTIVE)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  avatar    String?
  bio       String?

  // Broker-specific fields
  companyName     String?
  licenseNumber   String?
  gstNumber       String?
  officeAddress   String?

  // Builder-specific fields
  builderCompany  String?
  establishedYear Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  // Relations
  listings        Listing[]
  leads           Lead[]
  savedListings   SavedListing[]
  createdLeads    Lead[]           @relation("LeadCreatedBy")
  visitorVisits   Visit[]          @relation("VisitorVisits")
  ownerVisits     Visit[]          @relation("OwnerVisits")
  notifications   Notification[]   @relation("UserNotifications")

  // Broker/Team relations
  ownedTeams      Team[]           @relation("TeamOwner")
  teamMemberships TeamMember[]
  assignedLeads   LeadAssignment[]
  assignedLeadsBy LeadAssignment[] @relation("AssignedByUser")
  leadActivities  LeadActivity[]
  tasks           Task[]           @relation("TaskAssignee")
  createdTasks    Task[]           @relation("TaskCreator")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

// ============================================
// CITIES AND LOCALITIES (For Phase 1)
// ============================================

model City {
  id        String   @id @default(cuid())
  name      String
  state     String
  country   String   @default("India")

  latitude  Float?
  longitude Float?

  isActive  Boolean  @default(true)
  priority  Int      @default(0) // For ordering popular cities

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  localities Locality[]
  listings   Listing[]

  @@unique([name, state])
  @@index([isActive, priority])
  @@map("cities")
}

model Locality {
  id        String   @id @default(cuid())
  name      String
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  pincode   String?

  latitude  Float?
  longitude Float?

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings  Listing[]

  @@unique([name, cityId])
  @@index([cityId])
  @@index([isActive])
  @@map("localities")
}

// ============================================
// LISTINGS (PROPERTIES)
// ============================================

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  VILLA
  INDEPENDENT_HOUSE
  PLOT
  COMMERCIAL
  OFFICE
  SHOP
  WAREHOUSE
  PG
  HOSTEL
}

enum ListingStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  EXPIRED
  SOLD
  RENTED
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum AvailabilityStatus {
  IMMEDIATE
  WITHIN_15_DAYS
  WITHIN_30_DAYS
  AFTER_30_DAYS
}

model Listing {
  id        String   @id @default(cuid())

  // Ownership
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Team (Phase 3 - for broker team listings)
  teamId    String?
  team      Team?    @relation("TeamListings", fields: [teamId], references: [id])

  // Basic Info
  title     String
  description String  @db.Text

  listingType    ListingType
  propertyType   PropertyType
  status         ListingStatus @default(DRAFT)

  // Location
  cityId      String
  city        City      @relation(fields: [cityId], references: [id])
  localityId  String
  locality    Locality  @relation(fields: [localityId], references: [id])
  address     String    @db.Text
  pincode     String?
  latitude    Float?
  longitude   Float?

  // Property Details
  bhk         Int?      // Number of bedrooms (1, 2, 3, 4, etc.)
  bathrooms   Int?
  balconies   Int?

  carpetArea      Float?   // in sq ft
  builtUpArea     Float?   // in sq ft
  plotArea        Float?   // in sq ft

  furnishing      FurnishingStatus?

  totalFloors     Int?
  floorNumber     Int?

  // Pricing
  price           Float    // Main price
  pricePerSqft    Float?
  securityDeposit Float?   // For rent
  maintenanceFee  Float?   // Monthly maintenance

  // Availability
  availability    AvailabilityStatus?
  possessionDate  DateTime?

  // Age
  propertyAge     Int?     // in years

  // Features
  parking         Boolean  @default(false)
  parkingCount    Int?

  // Listing Management
  viewCount       Int      @default(0)
  contactCount    Int      @default(0)

  isFeatured      Boolean  @default(false)
  featuredUntil   DateTime?

  rejectionReason String?  @db.Text

  moderatedBy     String?
  moderatedAt     DateTime?

  publishedAt     DateTime?
  expiresAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  media           Media[]
  amenities       ListingAmenity[]
  leads           Lead[]
  savedBy         SavedListing[]
  visits          Visit[]

  @@index([userId])
  @@index([cityId])
  @@index([localityId])
  @@index([status])
  @@index([listingType])
  @@index([propertyType])
  @@index([price])
  @@index([publishedAt])
  @@map("listings")
}

// ============================================
// MEDIA (IMAGES & VIDEOS)
// ============================================

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Media {
  id          String    @id @default(cuid())

  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  type        MediaType @default(IMAGE)
  url         String
  thumbnailUrl String?

  title       String?
  description String?

  size        Int?      // in bytes
  mimeType    String?

  displayOrder Int      @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([listingId])
  @@index([displayOrder])
  @@map("media")
}

// ============================================
// AMENITIES
// ============================================

model Amenity {
  id          String   @id @default(cuid())
  name        String   @unique
  icon        String?
  category    String?  // e.g., "security", "lifestyle", "common_area"
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings    ListingAmenity[]

  @@index([category])
  @@map("amenities")
}

model ListingAmenity {
  id          String   @id @default(cuid())

  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  amenityId   String
  amenity     Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([listingId, amenityId])
  @@index([listingId])
  @@index([amenityId])
  @@map("listing_amenities")
}

// ============================================
// LEADS & INQUIRIES
// ============================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISIT_SCHEDULED
  VISITED
  NEGOTIATION
  WON
  LOST
  SPAM
}

enum LeadSource {
  PHONE_REVEAL
  CHAT
  EMAIL
  CALL
  WEBSITE_FORM
}

model Lead {
  id          String     @id @default(cuid())

  // Listing
  listingId   String
  listing     Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Lead info (buyer/tenant)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  name        String
  email       String?
  phone       String

  message     String?    @db.Text

  status      LeadStatus @default(NEW)
  source      LeadSource

  // Owner assignment
  ownerId     String
  owner       User       @relation("LeadCreatedBy", fields: [ownerId], references: [id])

  // CRM Pipeline (Phase 3)
  pipelineStage LeadPipelineStage @default(NEW)

  isRead      Boolean    @default(false)
  readAt      DateTime?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // CRM Relations (Phase 3)
  assignments LeadAssignment[]
  activities  LeadActivity[]

  @@index([listingId])
  @@index([userId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

// ============================================
// SAVED LISTINGS (WISHLIST)
// ============================================

model SavedListing {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("saved_listings")
}

// ============================================
// VISITS & SCHEDULING
// ============================================

enum VisitStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Visit {
  id            String      @id @default(cuid())

  // Listing
  listingId     String
  listing       Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Visitor (buyer/tenant)
  visitorId     String
  visitor       User        @relation("VisitorVisits", fields: [visitorId], references: [id], onDelete: Cascade)

  // Owner
  ownerId       String
  owner         User        @relation("OwnerVisits", fields: [ownerId], references: [id])

  // Visit details
  scheduledAt   DateTime
  status        VisitStatus @default(REQUESTED)

  visitorName   String
  visitorPhone  String
  visitorEmail  String?

  message       String?     @db.Text
  ownerNotes    String?     @db.Text

  // Confirmation
  confirmedAt   DateTime?
  confirmedBy   String?     // userId who confirmed

  // Rescheduling
  originalScheduledAt DateTime?
  rescheduledReason   String?  @db.Text

  // Completion
  completedAt   DateTime?
  feedback      String?     @db.Text
  rating        Int?        // 1-5 stars

  // Cancellation
  cancelledAt   DateTime?
  cancelledBy   String?     // userId who cancelled
  cancellationReason String? @db.Text

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([listingId])
  @@index([visitorId])
  @@index([ownerId])
  @@index([scheduledAt])
  @@index([status])
  @@index([createdAt])
  @@map("visits")
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  LEAD_RECEIVED
  VISIT_REQUESTED
  VISIT_CONFIRMED
  VISIT_RESCHEDULED
  VISIT_CANCELLED
  VISIT_REMINDER
  LISTING_APPROVED
  LISTING_REJECTED
  MESSAGE_RECEIVED
  SYSTEM_ANNOUNCEMENT
}

model Notification {
  id          String            @id @default(cuid())

  userId      String
  user        User              @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  message     String            @db.Text

  // Related entities
  listingId   String?
  leadId      String?
  visitId     String?

  // Metadata
  metadata    Json?

  isRead      Boolean           @default(false)
  readAt      DateTime?

  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// BROKER & TEAM MANAGEMENT (Phase 3)
// ============================================

enum TeamRole {
  OWNER      // Broker who owns the team
  ADMIN      // Can manage team members and settings
  AGENT      // Regular team member
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text

  // Owner (Broker)
  ownerId     String
  owner       User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members     TeamMember[]
  listings    Listing[]  @relation("TeamListings")

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id          String   @id @default(cuid())

  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role        TeamRole @default(AGENT)

  joinedAt    DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

// ============================================
// CRM & LEAD MANAGEMENT (Phase 3)
// ============================================

enum LeadPipelineStage {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT_SCHEDULED
  SITE_VISIT_COMPLETED
  NEGOTIATION
  DEAL_CLOSED
  LOST
}

enum LeadActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  STATUS_CHANGE
  ASSIGNMENT
}

model LeadAssignment {
  id          String   @id @default(cuid())

  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User    @relation(fields: [assignedToId], references: [id])

  assignedById String?
  assignedBy   User?   @relation("AssignedByUser", fields: [assignedById], references: [id])

  assignedAt   DateTime @default(now())

  @@index([leadId])
  @@index([assignedToId])
  @@map("lead_assignments")
}

model LeadActivity {
  id          String           @id @default(cuid())

  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId      String
  user        User             @relation(fields: [userId], references: [id])

  type        LeadActivityType
  title       String
  description String?          @db.Text

  // For calls/meetings
  duration    Int?             // in minutes
  scheduledAt DateTime?

  // Metadata
  metadata    Json?

  createdAt   DateTime         @default(now())

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
  @@map("lead_activities")
}

// ============================================
// TASK MANAGEMENT (Phase 3)
// ============================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())

  title       String
  description String?      @db.Text

  // Assignment
  assignedToId String
  assignedTo   User        @relation("TaskAssignee", fields: [assignedToId], references: [id])

  createdById  String
  createdBy    User        @relation("TaskCreator", fields: [createdById], references: [id])

  // Task details
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  dueDate     DateTime?
  completedAt DateTime?

  // Related entities
  leadId      String?
  listingId   String?

  // Reminders
  reminderSent Boolean     @default(false)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}
